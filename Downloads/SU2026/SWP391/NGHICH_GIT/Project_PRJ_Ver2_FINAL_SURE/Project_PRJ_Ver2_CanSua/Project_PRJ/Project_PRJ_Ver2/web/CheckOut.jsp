		<script>
			// Đồng bộ radio paymentMethod với hidden field gửi lên server
			$(function () {
				function syncPayment() {
					var val = $('input[name="paymentMethod"]:checked').val() || 'COD';
					$('#payment-hidden').val(val);
					
					// Hiển thị/ẩn QR code
					var qrSection = $('#qrSection');
					if (val === 'BANK' || val === 'ONLINE') {
						qrSection.slideDown(300);
						
						// Thay đổi tiêu đề theo phương thức
						if (val === 'BANK') {
							qrSection.find('h4').html('<i class="fa fa-qrcode"></i> Quét mã QR để chuyển khoản');
							qrSection.find('.fa-info-circle').parent().html('<i class="fa fa-info-circle"></i> Sau khi chuyển khoản thành công, vui lòng chờ trong giây lát để hệ thống xác nhận.');
						} else {
							qrSection.find('h4').html('<i class="fa fa-qrcode"></i> Quét mã QR để thanh toán online');
							qrSection.find('.fa-info-circle').parent().html('<i class="fa fa-info-circle"></i> Hệ thống sẽ tự động xác nhận thanh toán ngay sau khi quét mã thành công.');
						}
					} else {
						qrSection.slideUp(300);
					}
				}
				$('input[name="paymentMethod"]').on('change', syncPayment);
				syncPayment();
			});
		</script>
		
